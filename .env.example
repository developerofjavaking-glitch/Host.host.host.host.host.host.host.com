# Copy this file to .env for local testing (python-dotenv is NOT wired in by
# default — on Render/Railway/Pella etc. you set these in the dashboard
# instead of using a .env file).

# --- Required ---
BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather

# --- Admin / Owner ---
# One or more numeric Telegram user IDs, comma-separated
ADMIN_ID=7453801393
# Link used by the "Contact Owner" button
OWNER_LINK=https://t.me/King_Boom_69
# Link used by the "Updates Channel" button
CHANNEL_LINK=https://t.me/your_channel

# --- Branding ---
BOT_NAME=Boom Host Bot

# --- Behaviour ---
REQUIRE_CODE=true
MAX_FILES_PER_USER=10
MAX_UPLOAD_MB=20

# --- Storage (leave default unless you know you need to change it) ---
DATA_DIR=./data

# --- Only needed on platforms that require a bound HTTP port ---
ENABLE_KEEPALIVE=true
PORT=8080
